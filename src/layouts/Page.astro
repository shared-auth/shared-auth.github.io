---
import { LOGIN_ENTRY_POINTS, GITHUB_ORG } from "../lib/site-hosts.mjs";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lede?: string;
  noindex?: boolean;
}

const { title, description, eyebrow, heading, lede, noindex = false } =
  Astro.props;
const [userLogin, orgLogin] = LOGIN_ENTRY_POINTS;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#0b1020"
    />{noindex && <meta name="robots" content="noindex,nofollow" />}<title
      >{title}</title
    ></head
  ><body>
    <header>
      <a class="brand" href="/"><b>A</b> Shared Auth</a><nav>
        <a class="nav-section" href="/features/">Features</a><a
          class="nav-section"
          href="/roadmap/">Roadmap</a
        ><a class="nav-section" href="/security/">Security</a><a
          class="nav-section"
          href="/docs/">Docs</a
        ><a class="nav-section" href={GITHUB_ORG}>GitHub ↗</a><a
          class="nav-login"
          href={userLogin.href}
          data-login="user">{userLogin.label}</a
        ><a class="nav-login nav-login-org" href={orgLogin.href} data-login="org"
          >{orgLogin.label}</a
        ><a class="nav-dashboard" href="/dashboard/">Dashboard</a>
      </nav>
    </header>
    <main>
      <section class="page-hero">
        <p class="eyebrow">{eyebrow}</p><h1>{heading}</h1>{
          lede && <p class="lede">{lede}</p>
        }
      </section>
      <slot />
    </main><footer>
      <span>© 2026 Shared Auth</span><a href="/features/">Features</a><a
        href="/security/">Security</a
      ><a href="/roadmap/">Roadmap</a><a href="/docs/">Docs</a><a
        href="https://github.com/shared-auth/shared-auth-clients"
        >Client packages</a
      >
    </footer></body>
</html>
<style is:global>
  :root {
    --accent: #6d5dfc;
    --hot: #0ea5e9;
    --ink: #0b1020;
    --muted: #5f6b7c;
    --paper: #f6f7ff;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    overflow-x: hidden;
    background: linear-gradient(180deg, #eef2ff, var(--paper) 28rem);
    color: var(--ink);
    font:
      16px/1.6 Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;
  }
  a {
    color: inherit;
  }
  header,
  main,
  footer {
    width: min(1180px, calc(100% - 2rem));
    margin: auto;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 0;
  }
  .brand {
    font-weight: 900;
    text-decoration: none;
  }
  .brand b {
    display: inline-grid;
    width: 2.2rem;
    aspect-ratio: 1;
    place-items: center;
    margin-right: 0.5rem;
    border-radius: 0.7rem;
    background: var(--ink);
    color: white;
  }
  nav {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    font-size: 0.88rem;
    font-weight: 750;
  }
  nav a {
    text-decoration: none;
  }
  .nav-dashboard {
    padding: 0.45rem 0.75rem;
    border-radius: 0.65rem;
    background: var(--ink);
    color: white;
  }
  .nav-login {
    padding: 0.45rem 0.75rem;
    border: 1px solid #0f172a24;
    border-radius: 0.65rem;
    background: #ffffffcc;
  }
  .nav-login-org {
    border-color: #6d5dfc55;
    color: var(--accent);
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font:
      800 0.72rem/1 ui-monospace,
      monospace;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .page-hero {
    padding: 4rem 0 2.5rem;
  }
  .page-hero h1 {
    max-width: 18ch;
    margin: 0.8rem 0 1.2rem;
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }
  .lede {
    max-width: 52rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  section h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .panel {
    margin: 1.4rem 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid #0f172a14;
    border-radius: 1.3rem;
    background: #ffffffc4;
  }
  .grid-2,
  .grid-3 {
    display: grid;
    gap: 1rem;
  }
  .grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .card {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.1rem;
    border: 1px solid #0f172a14;
    border-radius: 1rem;
    background: #ffffffc4;
  }
  .card h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .status {
    justify-self: start;
    padding: 0.15rem 0.5rem;
    border-radius: 0.4rem;
    font:
      800 0.62rem/1.6 ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .status-shipped {
    background: #dcfce7;
    color: #166534;
  }
  .status-partial {
    background: #fef3c7;
    color: #92400e;
  }
  .status-planned {
    background: #e0e7ff;
    color: #3730a3;
  }
  .status-none {
    background: #f1f5f9;
    color: #475569;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 1rem 0 2rem;
    border: 1px solid #0f172a14;
    border-radius: 1rem;
    background: #ffffffd0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th,
  td {
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid #0f172a10;
    text-align: left;
    vertical-align: top;
  }
  th {
    color: var(--muted);
    font:
      800 0.68rem/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  code {
    padding: 0.1rem 0.32rem;
    border-radius: 0.35rem;
    background: #0f172a0f;
    font:
      0.86em/1.5 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
  }
  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 1.5rem 0 4rem;
  }
  .cta-row a {
    padding: 0.75rem 1.05rem;
    border: 1px solid #0f172a18;
    border-radius: 0.8rem;
    background: #ffffffcc;
    font-weight: 800;
    text-decoration: none;
  }
  .cta-row a.primary {
    background: var(--ink);
    color: white;
  }
  footer {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.5rem 0 3rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  footer span {
    margin-right: auto;
  }
  footer a {
    text-decoration: none;
  }
  @media (max-width: 1040px) {
    nav {
      gap: 0.7rem;
    }
    nav .nav-section {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 650px) {
    nav {
      gap: 0.5rem;
      font-size: 0.78rem;
    }
    .grid-2,
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
