---
interface Props {
  title: string;
  eyebrow: string;
  description: string;
}
const { title, eyebrow, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{title} · Shared Auth</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/" aria-label="Shared Auth home">
        <span aria-hidden="true">SA</span>
        <b>Shared Auth</b>
      </a>
      <nav aria-label="Shared Auth public surfaces">
        <a href="https://app.ores-shared-auth.com/">App</a>
        <a href="https://user.ores-shared-auth.com/">User</a>
        <a href="https://org.ores-shared-auth.com/">Organization</a>
        <a href="https://auth.ores-shared-auth.com/edge/healthz">Auth status</a>
      </nav>
    </header>
    <main>
      <section class="intro">
        <p>{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </section>
      <section class="panel"><slot /></section>
      <aside>
        <h2>Security boundary</h2>
        <p>
          This page sends only the fields shown in the form to the canonical
          Shared Auth API. It does not store submissions in browser storage, attach
          browser credentials, or log contact details.
        </p>
      </aside>
    </main>
    <footer>
      <a href="/quote/">Request a quote</a>
      <a href="/pre-interest/">Register interest</a>
      <a href="https://github.com/shared-auth">GitHub organization</a>
    </footer>
  </body>
</html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#0f172a;background:#f5f7fb;line-height:1.5;--ink:#0f172a;--muted:#536179;--line:#d9e0ea;--accent:#1d4ed8;--accent-strong:#1e40af;--success:#166534;--danger:#b91c1c}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 0%,#dbeafe 0,transparent 34rem),#f8fafc}header,footer{max-width:74rem;margin:auto;padding:1rem 1.4rem;display:flex;gap:1.2rem;align-items:center;justify-content:space-between}.brand{display:flex;gap:.7rem;align-items:center;text-decoration:none;color:var(--ink)}.brand span{display:grid;place-items:center;width:2.2rem;height:2.2rem;border-radius:.7rem;background:var(--ink);color:white;font-size:.74rem;font-weight:800;letter-spacing:.06em}nav,footer{flex-wrap:wrap}nav{display:flex;gap:.35rem}nav a,footer a{color:#334155;text-decoration:none;font-weight:700;font-size:.84rem;padding:.45rem .65rem;border-radius:.55rem}nav a:hover,nav a:focus-visible,footer a:hover,footer a:focus-visible{background:#e2e8f0;color:var(--ink)}main{max-width:62rem;margin:2.5rem auto 4rem;padding:0 1.4rem}.intro{max-width:45rem;margin-bottom:1.5rem}.intro>p:first-child{text-transform:uppercase;letter-spacing:.15em;font-size:.72rem;font-weight:850;color:var(--accent)}h1{font-size:clamp(2rem,5vw,4rem);line-height:1.02;letter-spacing:-.045em;margin:.3rem 0 1rem}.lede{font-size:1.08rem;color:var(--muted);max-width:42rem}.panel,aside{background:#fff;border:1px solid var(--line);border-radius:1.2rem;box-shadow:0 18px 55px #0f172a0d}.panel{padding:clamp(1.2rem,4vw,2.2rem)}aside{margin-top:1rem;padding:1rem 1.2rem}aside h2{font-size:.88rem;margin:0 0 .25rem}aside p{margin:0;color:var(--muted);font-size:.86rem}form{display:grid;gap:1.1rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.full{grid-column:1/-1}label,fieldset{display:grid;gap:.4rem;font-size:.84rem;font-weight:760}fieldset{border:1px solid var(--line);border-radius:.8rem;padding:.8rem 1rem}legend{padding:0 .3rem}input,select,textarea{width:100%;font:inherit;border:1px solid #cbd5e1;border-radius:.7rem;padding:.72rem .78rem;background:white;color:var(--ink)}input:focus,select:focus,textarea:focus{outline:3px solid #bfdbfe;border-color:var(--accent)}textarea{min-height:7rem;resize:vertical}.check-grid{display:flex;flex-wrap:wrap;gap:.65rem 1rem}.check-grid label,.consent{display:flex;align-items:flex-start;gap:.5rem;font-weight:600}.check-grid input,.consent input{width:auto;margin-top:.25rem}.honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}button[type=submit]{justify-self:start;border:0;border-radius:.75rem;background:var(--accent);color:white;padding:.78rem 1.15rem;font:inherit;font-weight:820;cursor:pointer}button[type=submit]:hover{background:var(--accent-strong)}button:disabled{opacity:.55;cursor:wait}[data-form-status]{min-height:1.5rem;margin:0;font-size:.88rem;font-weight:700}[data-form-status][data-state=success]{color:var(--success)}[data-form-status][data-state=error]{color:var(--danger)}footer{border-top:1px solid var(--line);justify-content:center}@media(max-width:760px){header{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.full{grid-column:auto}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
