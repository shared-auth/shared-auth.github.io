---
interface Props { href?: string }
const { href = "/dashboard/" } = Astro.props;
---
<div class="public-actions" aria-label="Shared Auth public actions">
  <a class="dashboard-cta" href={href} aria-label="Open the Shared Auth dashboard handoff">
    <span><b>Dashboard</b><small>Users · sessions · roles</small></span>
    <i aria-hidden="true">→</i>
  </a>
  <a class="secondary-cta" href="/quote/"><b>Request a quote</b><small>Capacity · SSO · support</small></a>
  <a class="secondary-cta" href="/pre-interest/"><b>Register interest</b><small>Early access · integrations</small></a>
</div>
<style>
.public-actions{display:flex;flex-wrap:wrap;gap:.65rem;align-items:stretch}.dashboard-cta,.secondary-cta{display:inline-flex;gap:.9rem;align-items:center;justify-content:space-between;min-width:15rem;padding:.8rem 1rem;border:1px solid #0f172a18;border-radius:.9rem;text-decoration:none;transition:transform .16s ease,box-shadow .16s ease}.dashboard-cta{background:var(--ink);color:white;box-shadow:0 14px 34px #0f172a20}.secondary-cta{display:grid;background:#fff;color:var(--ink)}.dashboard-cta:hover,.secondary-cta:hover{transform:translateY(-2px);box-shadow:0 18px 42px #0f172a20}.dashboard-cta span{display:grid;text-align:left}.dashboard-cta b,.secondary-cta b{font-size:.92rem}.dashboard-cta small{color:#cbd5e1}.secondary-cta small{color:#64748b}.dashboard-cta small,.secondary-cta small{font-size:.68rem;font-weight:650}.dashboard-cta i{font-size:1.1rem;font-style:normal}@media(prefers-reduced-motion:reduce){.dashboard-cta,.secondary-cta{transition:none}.dashboard-cta:hover,.secondary-cta:hover{transform:none}}
</style>
