---
import Page from "../layouts/Page.astro";
import {
  CATEGORIES,
  STATUS,
  TIERS,
  countByStatus,
  ALL_CAPABILITIES,
} from "../lib/capabilities.mjs";

const counts = countByStatus();
const total = ALL_CAPABILITIES.length;
---

<Page
  title="Features — Shared Auth"
  description="The shared-auth capability register: every identity-platform capability we track, and exactly what is shipped, partial, planned or deliberately out of scope."
  eyebrow="Capability register"
  heading="Everything we track, and where it actually stands."
  lede="This page is generated from one register in the repository. A capability is marked shipped only when it is reachable in production. Nothing here is a claim about anyone else's product."
>
  <section class="summary">
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Status</th><th>Count</th><th>Meaning</th></tr>
        </thead>
        <tbody>
          <tr
            ><td><span class="status status-shipped">Shipped</span></td><td
              >{counts.shipped}</td
            ><td>Reachable in production today.</td></tr
          >
          <tr
            ><td><span class="status status-partial">Partial</span></td><td
              >{counts.partial}</td
            ><td>Reachable, but narrower than the category expects.</td></tr
          >
          <tr
            ><td><span class="status status-planned">Planned</span></td><td
              >{counts.planned}</td
            ><td>Accepted onto the roadmap with a milestone.</td></tr
          >
          <tr
            ><td><span class="status status-none">Not planned</span></td><td
              >{counts.none}</td
            ><td>Deliberately out of scope, with the reason recorded.</td></tr
          >
          <tr><td><b>Tracked</b></td><td><b>{total}</b></td><td /></tr>
        </tbody>
      </table>
    </div>
  </section>
  {
    CATEGORIES.map((category) => (
      <section id={category.id}>
        <h2>{category.name}</h2>
        <p class="lede">{category.blurb}</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Capability</th>
                <th>Status</th>
                <th>Market</th>
                <th>Where it stands</th>
              </tr>
            </thead>
            <tbody>
              {category.capabilities.map((capability) => (
                <tr id={capability.id}>
                  <td>{capability.title}</td>
                  <td>
                    <span class={`status ${STATUS[capability.status].className}`}>
                      {STATUS[capability.status].label}
                    </span>
                  </td>
                  <td>{TIERS[capability.tier]}</td>
                  <td>{capability.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
  <div class="cta-row">
    <a class="primary" href="/roadmap/">See the milestone plan →</a><a
      href="/security/">Security posture</a
    ><a href="/docs/">Documentation</a>
  </div>
</Page>
