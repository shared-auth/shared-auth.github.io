---
import {
  capabilityLedger,
  capabilityStatuses,
} from "../lib/capability-ledger.mjs";

const statusOrder = ["available", "partial", "in_review", "planned", "blocked"];
const statusCounts = Object.fromEntries(
  statusOrder.map((status) => [
    status,
    capabilityLedger.capabilities.filter((capability) => capability.status === status).length,
  ]),
);
const statusClass = (status) => `status status-${status.replace("_", "-")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta
      name="description"
      content="The evidence-based Shared Auth IAM and CIAM capability ledger, architecture, host contract, and delivery gates."
    />
    <meta name="theme-color" content="#07111f" />
    <title>IAM/CIAM capability ledger · Shared Auth</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><b>A</b><span>Shared Auth</span></a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="#capabilities" aria-current="page">Capabilities</a>
        <a href="#runtime">Runtime</a>
        <a href="/capabilities.json">JSON contract</a>
        <a href="https://github.com/shared-auth">GitHub ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <p class="eyebrow">Contract {capabilityLedger.contract}</p>
          <h1>Identity parity starts with <em>honest evidence.</em></h1>
          <p class="lede">
            Shared Auth is being built as a first-party IAM and CIAM control plane:
            account security, organizations, enterprise federation, directory lifecycle,
            policy, audit, and resilient deployment. This page separates code that exists
            from workflows still in review, planned, or blocked.
          </p>
          <div class="actions">
            <a class="primary" href="#capabilities">Inspect the ledger</a>
            <a href="/capabilities.json">Read the machine contract</a>
            <a href="https://github.com/shared-auth">Review the repositories ↗</a>
          </div>
        </div>
        <aside aria-label="Delivery summary">
          <p>Evidence date</p>
          <strong>{capabilityLedger.asOf}</strong>
          <dl>
            {
              statusOrder.map((status) => (
                <div>
                  <dt><span class={statusClass(status)}>{status.replace("_", " ")}</span></dt>
                  <dd>{statusCounts[status]}</dd>
                </div>
              ))
            }
          </dl>
          <small>Linear delivery record: {capabilityLedger.issue}</small>
        </aside>
      </section>

      <section class="principle" aria-label="Evidence policy">
        <p>{capabilityLedger.disclaimer}</p>
      </section>

      <section id="capabilities" class="ledger">
        <div class="section-heading">
          <p class="eyebrow">IAM/CIAM delivery ledger</p>
          <h2>One product goal, explicit gates.</h2>
          <p>
            Each domain is evaluated independently. UI parity requires backend authority;
            backend primitives do not become a shipped user workflow merely because an
            endpoint or SDK method exists.
          </p>
        </div>

        <div class="legend" aria-label="Status definitions">
          {
            statusOrder.map((status) => (
              <article>
                <span class={statusClass(status)}>{status.replace("_", " ")}</span>
                <p>{capabilityStatuses[status]}</p>
              </article>
            ))
          }
        </div>

        <div class="capabilities">
          {
            capabilityLedger.capabilities.map((capability, index) => (
              <article id={capability.id}>
                <div class="capability-title">
                  <small>{String(index + 1).padStart(2, "0")}</small>
                  <span class={statusClass(capability.status)}>
                    {capability.status.replace("_", " ")}
                  </span>
                </div>
                <h3>{capability.domain}</h3>
                <p>{capability.userSurface}</p>
                <h4>Repository evidence</h4>
                {capability.backendEvidence.length ? (
                  <ul>
                    {capability.backendEvidence.map((evidence) => <li><code>{evidence}</code></li>)}
                  </ul>
                ) : (
                  <p class="none">No implementation is claimed.</p>
                )}
                <h4>Next fail-closed gate</h4>
                <p class="gate">{capability.nextGate}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="runtime" class="runtime">
        <div class="section-heading">
          <p class="eyebrow">Public and private origin contract</p>
          <h2>Exact hosts, four services, two runtimes.</h2>
          <p>
            Cloudflare is the only intended public edge. Customer and administrator
            identities, origins, secrets, database roles, and ingress remain separate.
            Google Cloud Run is the intended primary runtime and the custom Kubernetes
            cluster is the intended fallback; provider activation is not certified merely
            because a manifest exists.
          </p>
        </div>

        <div class="architecture" aria-label="Target runtime architecture">
          <div class="edge">
            <small>PUBLIC EDGE</small>
            <strong>Cloudflare exact-host router</strong>
            <span>DNS · TLS · policy · health-aware origin selection</span>
          </div>
          <div class="arrow" aria-hidden="true">↓</div>
          <div class="origins">
            <article>
              <small>PRIMARY</small>
              <strong>Google Cloud Run</strong>
              <span>four separately identified services · immutable image promotion</span>
            </article>
            <article>
              <small>FALLBACK</small>
              <strong>oresoftware/k8s-cluster</strong>
              <span>four services · probes · disruption policy · restricted ingress</span>
            </article>
          </div>
          <div class="arrow" aria-hidden="true">↓</div>
          <div class="services">
            <span>customer web</span><span>customer API</span><span>admin web</span><span>admin API</span>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <caption>Canonical host contract</caption>
            <thead>
              <tr>
                <th scope="col">Host</th>
                <th scope="col">Purpose</th>
                <th scope="col">Service</th>
                <th scope="col">Exposure</th>
                <th scope="col">Certification</th>
              </tr>
            </thead>
            <tbody>
              {
                capabilityLedger.hostContract.map((route) => (
                  <tr>
                    <th scope="row"><code>{route.host}</code></th>
                    <td>{route.purpose}</td>
                    <td>{route.service}</td>
                    <td>{route.exposure}</td>
                    <td><span class={statusClass(route.certification)}>{route.certification.replace("_", " ")}</span></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <article class="activation-gate">
          <h3>Production activation gate</h3>
          <p>
            DNS records, Worker routes, Cloud Run revisions, Kubernetes workloads, health
            failover, and rollback are active only after read-after-write evidence from the
            actual Cloudflare, Google Cloud, and Kubernetes control planes. Repository code
            alone does not satisfy this gate.
          </p>
        </article>
      </section>

      <section class="references">
        <div class="section-heading">
          <p class="eyebrow">Feature taxonomy inputs</p>
          <h2>Learn broadly. Copy nothing blindly.</h2>
          <p>
            These products and projects inform the parity taxonomy. Shared Auth keeps its
            own contracts, security model, UI, deployment topology, and evidence thresholds.
          </p>
        </div>
        <div class="reference-grid">
          {
            capabilityLedger.taxonomyReferences.map((reference) => (
              <a href={reference.url}>{reference.name}<span aria-hidden="true">↗</span></a>
            ))
          }
        </div>
      </section>

      <section class="closing">
        <p class="eyebrow">No implicit parity</p>
        <h2>Backend authority and usable UI land together.</h2>
        <p>
          The immediate delivery slices are the customer account security center, the
          isolated administrator IAM ledger, and the complete four-service runtime contract.
          Enterprise federation, directory lifecycle, risk policy, and global session control
          remain gated until their authorities are real.
        </p>
        <div class="actions">
          <a class="primary" href="/dashboard/">Open the public handoff</a>
          <a href="https://github.com/shared-auth">Inspect Shared Auth ↗</a>
        </div>
      </section>
    </main>

    <footer>
      <span>© 2026 Shared Auth</span>
      <span>Astro on GitHub Pages · no Jekyll · no Hugo</span>
      <a href="/capabilities.json">Capability contract</a>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f5f7ff;
    --ink: #07111f;
    --muted: #536176;
    --line: #d9e1ee;
    --panel: #ffffff;
    --accent: #6557f5;
    --hot: #0284c7;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background:
      radial-gradient(circle at 92% 0%, #bfe8ff 0, transparent 25rem),
      linear-gradient(180deg, #edf1ff, var(--paper) 34rem);
    color: var(--ink);
    font: 16px/1.6 Inter, ui-sans-serif, system-ui, sans-serif;
  }
  a { color: inherit; }
  header, main, footer { width: min(1180px, calc(100% - 2rem)); margin: auto; }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
  }
  .brand { display: inline-flex; align-items: center; font-weight: 900; text-decoration: none; }
  .brand b {
    display: inline-grid;
    width: 2.2rem;
    aspect-ratio: 1;
    place-items: center;
    margin-right: .5rem;
    border-radius: .7rem;
    background: var(--ink);
    color: white;
  }
  nav { display: flex; gap: 1rem; flex-wrap: wrap; font-size: .86rem; font-weight: 750; }
  nav a { text-decoration: none; }
  nav a:hover, nav a:focus-visible { text-decoration: underline; text-underline-offset: .3rem; }
  .hero {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: clamp(2rem, 7vw, 6rem);
    align-items: center;
    min-height: 42rem;
    padding: 5rem 0;
  }
  .eyebrow {
    margin: 0;
    color: var(--accent);
    font: 800 .72rem/1 ui-monospace, monospace;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 13ch;
    margin: .8rem 0 1.3rem;
    font-size: clamp(3.4rem, 8vw, 6.8rem);
    line-height: .9;
    letter-spacing: -.07em;
  }
  h1 em {
    background: linear-gradient(120deg, var(--accent), var(--hot));
    background-clip: text;
    color: transparent;
    font-style: normal;
  }
  .lede, .section-heading > p:not(.eyebrow), .closing > p:not(.eyebrow) {
    max-width: 48rem;
    color: var(--muted);
    font-size: 1.08rem;
  }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  .actions a {
    padding: .72rem 1rem;
    border: 1px solid #0f172a20;
    border-radius: .75rem;
    background: #ffffffaa;
    font-weight: 800;
    text-decoration: none;
  }
  .actions .primary { background: var(--ink); color: white; }
  .hero aside {
    padding: 1.5rem;
    border: 1px solid #ffffff88;
    border-radius: 1.5rem;
    background: #07111feF;
    color: white;
    box-shadow: 0 28px 70px #0f172a35;
  }
  .hero aside > p, .hero aside > small { color: #aebdd0; }
  .hero aside > strong { font-size: 2rem; }
  dl { display: grid; gap: .6rem; margin: 1.5rem 0; }
  dl div { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  dd { margin: 0; font-weight: 900; }
  .status {
    display: inline-block;
    padding: .22rem .6rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .status-available { background: #d7f7e8; color: #126545; }
  .status-partial { background: #fff1b9; color: #735600; }
  .status-in-review { background: #dcecff; color: #165b95; }
  .status-planned { background: #e9e5ff; color: #5441a8; }
  .status-blocked { background: #ffe0e4; color: #9b2938; }
  .principle {
    margin: 0 0 6rem;
    padding: 1.2rem 1.4rem;
    border-left: .35rem solid var(--accent);
    background: white;
    box-shadow: 0 12px 32px #0f172a0e;
  }
  .principle p { margin: 0; font-weight: 750; }
  .ledger, .runtime, .references, .closing { padding: 5rem 0; }
  .section-heading h2, .closing h2 {
    max-width: 18ch;
    margin: .8rem 0 1rem;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: .98;
    letter-spacing: -.055em;
  }
  .legend, .capabilities, .reference-grid, .origins, .services {
    display: grid;
    gap: 1rem;
  }
  .legend { grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 2rem 0; }
  .legend article, .capabilities article, .activation-gate {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--panel);
  }
  .legend article { padding: .85rem; }
  .legend p { margin: .65rem 0 0; color: var(--muted); font-size: .82rem; }
  .capabilities { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .capabilities article { padding: 1.2rem; }
  .capability-title { display: flex; justify-content: space-between; align-items: center; gap: .8rem; }
  .capability-title small { color: var(--muted); font-family: ui-monospace, monospace; }
  h3 { margin: 1rem 0 .6rem; font-size: 1.25rem; line-height: 1.2; }
  h4 { margin: 1.15rem 0 .35rem; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .capabilities p, .capabilities li { color: var(--muted); font-size: .9rem; }
  .capabilities ul { margin: .4rem 0; padding-left: 1.2rem; }
  code { overflow-wrap: anywhere; font-family: ui-monospace, SFMono-Regular, monospace; }
  .none { font-style: italic; }
  .gate { padding-top: .7rem; border-top: 1px solid var(--line); }
  .architecture {
    margin: 2.5rem 0;
    padding: 2rem;
    border-radius: 1.5rem;
    background: #07111f;
    color: white;
  }
  .architecture small { color: #aebdd0; font: 700 .66rem/1 ui-monospace, monospace; letter-spacing: .1em; }
  .architecture strong, .architecture span { display: block; }
  .architecture span { color: #aebdd0; font-size: .88rem; }
  .edge { text-align: center; }
  .edge strong { margin: .35rem 0; font-size: 1.5rem; }
  .arrow { padding: 1rem; text-align: center; color: #8dd8ff; font-size: 1.5rem; }
  .origins { grid-template-columns: 1fr 1fr; }
  .origins article { padding: 1rem; border: 1px solid #ffffff20; border-radius: .8rem; background: #0d1b2c; }
  .origins strong { margin: .35rem 0; }
  .services { grid-template-columns: repeat(4, 1fr); }
  .services span { padding: .8rem; border: 1px solid #ffffff20; border-radius: .7rem; background: #0d1b2c; text-align: center; color: white; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 1rem; background: white; }
  table { width: 100%; min-width: 60rem; border-collapse: collapse; }
  caption { padding: 1rem; text-align: left; font-weight: 900; font-size: 1.2rem; }
  th, td { padding: .8rem 1rem; border-top: 1px solid var(--line); text-align: left; vertical-align: top; }
  thead th { background: #eef2ff; font-size: .78rem; letter-spacing: .05em; text-transform: uppercase; }
  tbody td { color: var(--muted); }
  .activation-gate { margin-top: 1rem; padding: 1.2rem; border-left: .35rem solid #b42336; }
  .activation-gate p { color: var(--muted); }
  .reference-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 2rem; }
  .reference-grid a {
    display: flex;
    justify-content: space-between;
    gap: .8rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: .8rem;
    background: white;
    font-weight: 800;
    text-decoration: none;
  }
  .reference-grid a:hover, .reference-grid a:focus-visible { border-color: var(--accent); }
  .closing { margin-bottom: 3rem; border-top: 1px solid var(--line); }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: .82rem;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .legend, .capabilities { grid-template-columns: 1fr 1fr; }
    .reference-grid { grid-template-columns: repeat(2, 1fr); }
    .services { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    header { align-items: flex-start; }
    nav { justify-content: flex-end; }
    h1 { font-size: 3.2rem; }
    .legend, .capabilities, .origins, .reference-grid, .services { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
