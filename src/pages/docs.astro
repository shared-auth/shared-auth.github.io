---
import Page from "../layouts/Page.astro";
import {
  API_ORIGIN,
  AUTH_ORIGIN,
  USER_ORIGIN,
  ORG_ORIGIN,
  ADMIN_ORIGIN,
  ADMIN_API_ORIGIN,
  GITHUB_ORG,
} from "../lib/site-hosts.mjs";

const hostnames = [
  [
    "ores-shared-auth.com",
    "Marketing site",
    "This site. Static, credential-free, built from source on every push.",
  ],
  [USER_ORIGIN, "User login and account", "Sign-in, profile, factors and sessions for a person."],
  [ORG_ORIGIN, "Organization login and console", "Organization workspace: members, roles and connections."],
  [AUTH_ORIGIN, "Identity plane", "Token exchange, introspection, JWKS and factor ceremonies."],
  [API_ORIGIN, "Product API", "The public application programming interface."],
  [ADMIN_ORIGIN, "Super-admin console", "Network-restricted operator console."],
  [ADMIN_API_ORIGIN, "Admin API", "Network-restricted administrative interface."],
];

const repositories = [
  ["shared-auth-server.rs", "The identity plane: ceremonies, tokens, revocation."],
  ["shared-auth-api-server.rs", "The public product API tier."],
  ["shared-auth-web-server.rs", "User and organization web surfaces."],
  ["shared-auth-admin-web-server.rs", "The operator console."],
  ["shared-auth-admin-api-server.rs", "The administrative interface."],
  ["shared-auth-interfaces", "Generated identity contracts shared by every client."],
  ["shared-auth-clients", "Client packages for every supported runtime."],
  ["shared-auth-lib", "Guard logic for applications that consume identity."],
  ["shared-auth-infra", "Terraform, edge configuration and deployment contracts."],
  ["shared-auth-docs", "Architecture notes, the parity register and runbooks."],
];
---

<Page
  title="Documentation — Shared Auth"
  description="Where the shared-auth documentation lives: hostnames, repositories, client packages and the integration boundary between the identity plane and your application."
  eyebrow="Documentation"
  heading="Start with the boundary, not the endpoints."
  lede="Shared Auth proves identity and assurance. Your application still owns tenant, role and resource authorization. Almost every integration question resolves once that line is clear."
>
  <section id="hostnames">
    <h2>Hostnames</h2>
    <p class="lede">
      Every surface has its own hostname so that network policy, not
      application code, is what keeps the administrative plane unreachable.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Hostname</th><th>Surface</th><th>Purpose</th></tr>
        </thead>
        <tbody>
          {
            hostnames.map(([host, surface, purpose]) => (
              <tr>
                <td>
                  <code>{host.replace("https://", "")}</code>
                </td>
                <td>{surface}</td>
                <td>{purpose}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
  <section id="integration">
    <h2>The integration boundary</h2>
    <div class="grid-3">
      <article class="card">
        <h3>1 · Exchange</h3>
        <p>
          A provider token becomes one verified shared-auth identity contract,
          so downstream services stop making provider-specific assumptions.
        </p>
      </article>
      <article class="card">
        <h3>2 · Introspect</h3>
        <p>
          Services verify online with an independent service credential that is
          accepted on the introspection endpoint and nowhere else.
        </p>
      </article>
      <article class="card">
        <h3>3 · Demand assurance</h3>
        <p>
          A sensitive operation requires an assurance level rather than assuming
          one. If the session cannot satisfy it, the caller steps up.
        </p>
      </article>
    </div>
  </section>
  <section id="repositories">
    <h2>Repositories</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Repository</th><th>What it holds</th></tr>
        </thead>
        <tbody>
          {
            repositories.map(([name, description]) => (
              <tr>
                <td>
                  <a href={`${GITHUB_ORG}/${name}`}>
                    <code>{name}</code>
                  </a>
                </td>
                <td>{description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
  <div class="cta-row">
    <a class="primary" href={`${GITHUB_ORG}/shared-auth-docs`}
      >Documentation repository ↗</a
    ><a href="/features/">Capability register</a><a href="/roadmap/">Roadmap</a>
  </div>
</Page>
