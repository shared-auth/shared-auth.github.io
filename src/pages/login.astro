---
import Page from "../layouts/Page.astro";
import { LOGIN_ENTRY_POINTS, ADMIN_ORIGIN } from "../lib/site-hosts.mjs";
---

<Page
  title="Sign in — Shared Auth"
  description="Choose a sign-in surface: a personal account, or an organization workspace."
  eyebrow="Sign in"
  heading="Two doors, deliberately."
  lede="A personal account and an organization workspace are different security contexts. They get different hostnames so a session issued for one is never presented to the other."
>
  <section id="entry-points">
    <div class="grid-2">
      {
        LOGIN_ENTRY_POINTS.map((entry) => (
          <article class="card">
            <h3>{entry.label}</h3>
            <p>{entry.description}</p>
            <p>
              <code>{entry.href.replace("https://", "")}</code>
            </p>
            <p>
              <a href={entry.href} data-login-cta={entry.id}>
                Continue →
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>
  <section id="operators" class="panel">
    <h2>Operators</h2>
    <p class="lede">
      The super-admin console at <code
        >{ADMIN_ORIGIN.replace("https://", "")}</code
      > is not reachable from the public internet. Reach it from an
      authorized network; there is no public sign-in page for it by design.
    </p>
  </section>
</Page>
