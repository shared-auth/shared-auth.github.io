---
import PublicIntakeShell from "../components/PublicIntakeShell.astro";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<PublicIntakeShell
  title="Register pre-interest"
  eyebrow="Early access and integration planning"
  description="Register interest before production intake opens. Registration does not create an account, organization, role, entitlement, quote, invoice, or charge."
>
  <form id="pre-interest-form" novalidate>
    <div class="grid">
      <label>Name <input name="name" autocomplete="name" maxlength="120" /></label>
      <label>Email <input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
      <label>Interest type
        <select name="party_type" required>
          <option value="">Select one</option>
          <option value="individual">Individual / developer</option>
          <option value="organization">Organization</option>
          <option value="partner">Integration partner</option>
        </select>
      </label>
      <label>Organization name <input name="organization_name" autocomplete="organization" maxlength="160" /></label>
      <label>Expected launch
        <select name="expected_launch" required>
          <option value="now">As soon as available</option>
          <option value="quarter">Within three months</option>
          <option value="six_months">Within six months</option>
          <option value="exploring">Exploring / no date</option>
        </select>
      </label>
      <label class="full">Use case
        <textarea name="use_case" maxlength="2000" required placeholder="What are you authenticating, and is this for individual users, organizations, or both?"></textarea>
      </label>
    </div>
    <label class="honeypot" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
    <label class="consent">
      <input type="checkbox" name="contact_consent" value="yes" required />
      <span>I consent to Shared Auth storing and reviewing this registration and contacting me about it.</span>
    </label>
    <label class="consent">
      <input type="checkbox" name="marketing_consent" value="yes" />
      <span>I separately consent to receiving Shared Auth launch and integration updates. This is optional.</span>
    </label>
    {turnstileSiteKey ? (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="shared_auth_pre_interest"></div>
    ) : (
      <p class="configuration-error" role="alert">Submissions are disabled until the abuse-prevention site key is configured.</p>
    )}
    <button type="submit" disabled={!turnstileSiteKey}>Register interest</button>
    <p data-form-status role="status" aria-live="polite"></p>
  </form>
</PublicIntakeShell>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  import { bindIntakeForm } from "../lib/intake-client.mjs";
  bindIntakeForm({ formId: "pre-interest-form", kind: "preInterest" });
</script>
